{
  "name": "transparency-portal",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "description": "A forkable FY2027 budget transparency portal for one LGU or DPWH district engineering office, built on the BetterGov.ph Budget API.",
  "scripts": {
    "dev": "vite",
    "setup": "tsx scripts/setup.ts",
    "check": "tsx scripts/check.ts",
    "chat:check": "tsx scripts/check-gemini.ts",
    "test:chat-setup": "tsx scripts/check-gemini.ts --self-test",
    "rag:build": "tsx scripts/build-rag.ts",
    "test:rag": "tsx --test tests/rag.test.ts",
    "test:chat": "tsx --test tests/chat.test.ts tests/budget-api.test.ts",
    "test:evaluation": "tsx --test tests/chat-evaluation.test.ts",
    "test:chat-ui": "tsx scripts/check-chat-ui.ts",
    "build": "tsc -b && vite build",
    "build:vercel": "npm run rag:build && npm run build",
    "preview": "vite preview",
    "lint": "eslint .",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "build:poster": "tsx scripts/build-poster.ts"
  },
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "playwright-core": "1.63.0",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "wrangler": "^4.92.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
