# Optional. The Budget API host the portal reads from. Leave unset to use the
# value in portal.config.ts (https://budget.bettergov.ph by default).
# VITE_API_BASE=https://budget.bettergov.ph

# Budget assistant: server/CLI only. Never prefix these names with VITE_.
# Copy to .env.local for vercel dev / the smoke check; see docs/ai-setup.md.
# Leave disabled until the account, free-tier model, quotas and terms are verified.
# Vercel: set Preview and Production separately; initially enable only a protected
# Preview. Keep Production false with no key until the pilot is approved.
# Changes require redeployment. WAF and operating steps: docs/deploy.md.
CHAT_ENABLED=false
# Exact verified ID, without models/; must support systemInstruction and JSON
# responseSchema with temperature 0 and maxOutputTokens 600 (including reasoning).
GEMINI_MODEL=
GEMINI_API_KEY=
