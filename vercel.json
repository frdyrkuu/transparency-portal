{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "functions": {
    "api/chat.ts": { "includeFiles": "data/rag/antipolo.json", "maxDuration": 30 }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api(?:/.*)?", "status": 404 },
    { "src": "/((?!@|src/|node_modules/)[^.]*)", "dest": "/index.html" }
  ]
}
